<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_offline_icon">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_wifi_off" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.03"
        android:text="@string/offline_title"
        android:textAlignment="center"
        android:textColor="@color/menius_ink"
        android:textSize="30sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.3"
        android:maxWidth="360dp"
        android:text="@string/offline_body"
        android:textAlignment="center"
        android:textColor="@color/menius_mute"
        android:textSize="16sp" />

    <include
        android:id="@+id/offlineActions"
        layout="@layout/offline_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp" />
</LinearLayout>
