<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen: no toolbar. The Counter (web) owns the whole display; printer
     settings and "disconnect tablet" live in the Counter's own menu and reach
     native code through the MeniusAndroid JS bridge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/menius_bg">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/menius_bg" />

    <!-- Covers the WebView when the main document fails to load, so the till
         never shows Chromium's raw "webpage not available" page. -->
    <FrameLayout
        android:id="@+id/offlinePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/menius_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <include
            android:id="@+id/offlineContent"
            layout="@layout/offline_content" />
    </FrameLayout>
</FrameLayout>
